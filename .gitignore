# SimpleTES suite (benchmarks/simpletes): upstream's vendored OpenProblems library has a
# tasks/ package that the "Local documentation" rule above would otherwise hide.
!benchmarks/simpletes/datasets/open_problems_bio/openproblems/openproblems/tasks/
# Data the SimpleTES families download or build locally (mirrors upstream's .gitignore)
benchmarks/simpletes/datasets/astrodynamics/data/ephemerides/
benchmarks/simpletes/datasets/scaling_law/.sldbench_cached
benchmarks/simpletes/datasets/scaling_law/*/dataset/
benchmarks/simpletes/datasets/open_problems_bio/denoising/denoising_datasets/
benchmarks/simpletes/datasets/qubit_routing/*/rust/.cargo_target/
benchmarks/simpletes/datasets/qubit_routing/*/rust/target/
benchmarks/simpletes/checkpoints/
benchmarks/simpletes/datasets/ahc/cache_ahc.zip
benchmarks/simpletes/datasets/ahc/ale-bench.tar
benchmarks/simpletes/datasets/ahc/ale_bench/

